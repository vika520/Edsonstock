# WorkBuddy 本地记忆 / 自动化状态：含个人工作记录，不同步到远端
.workbuddy/

# Wrangler 本地开发缓存 / node_modules：不入库
.wrangler/
node_modules/

# 本地私有部署配置（含内网地址，绝不入库；公开仓库靠环境变量或本地此文件驱动）
wolf-cycle/hosts.py

# 运行日志 / 运行时状态（每日变化，含完整日志，不入库；本地文件保留）
wolf-cycle/logs/
deploy/last_run.json

# deploy/ 是 stage() 每次重建的暂存目录（含真实站点 URL 的复盘页），不入库；
# 本地保留供 scp 部署，公开仓库无需这些重复产物与内网地址
deploy/

# Python 缓存
__pycache__/
*.py[cod]
*.pyo

# 可重建的增量状态缓存（约 23MB，由 `python fetch_flow.py --full` 重建，
# 每日变化会迅速撑大 git 历史，故不入库；本地文件保留）
wolf-cycle/data/flow_state.json

# 一次性数据源探测产物（ERP / TMT 取数探测时的临时缓存，不入库；本地保留）
wolf-cycle/data/_probe_*
wolf-cycle/cffex_probe.xml

# 截图 / 预览 PNG：仅本地交付用，不入库（仓库只保留构建必需的 logo）
*.png
!wolf-cycle/assets/edsonstock-logo.png

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
